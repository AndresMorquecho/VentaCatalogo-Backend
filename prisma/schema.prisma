generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                   String              @id @default(uuid())
  identificationType   String              @map("identification_type")
  identificationNumber String              @unique @map("identification_number")
  firstName            String              @map("first_name")
  country              String
  province             String
  city                 String
  address              String
  neighborhood         String?
  sector               String?
  email                String
  phone1               String              @map("phone1")
  operator1            String              @map("operator1")
  phone2               String?             @map("phone2")
  operator2            String?             @map("operator2")
  reference            String?
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  birthDate                  DateTime?           @map("birth_date")
  identificationIssuanceDate DateTime?           @map("identification_issuance_date")
  isBlocked                  Boolean             @default(false) @map("is_blocked")
  isWhatsApp           Boolean             @default(false) @map("is_whatsapp")
  lastDataUpdate       DateTime            @default(now()) @map("last_data_update")
  referredById         String?             @map("referred_by_id")
  lastOrderDate        DateTime?           @map("last_order_date")
  lastBrandName        String?             @map("last_brand_name")
  createdByName        String?             @map("created_by_name")
  blockedReason        String?             @map("blocked_reason")
  calls                Call[]
  catalogDeliveries    CatalogDelivery[]
  clientAccount        ClientAccount?
  referredBy           Client?             @relation("ClientReferral", fields: [referredById], references: [id])
  referrals            Client[]            @relation("ClientReferral")
  financialRecords     FinancialRecord[]
  inventoryMovements   InventoryMovement[]
  rewardRedemptions    LoyaltyRedemption[]
  exchanges            OrderExchange[]
  orderReceipts        OrderReceipt[]
  orders               Order[]
  walletRecharges      WalletRecharge[]

  @@index([firstName])
  @@index([email])
  @@index([identificationNumber])
  @@map("clients")
}

model Brand {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  catalogDeliveries  CatalogDelivery[]   @relation("BrandCatalogDelivery")
  catalogInventories CatalogInventory[]  @relation("BrandCatalogInventory")
  inventoryMovements InventoryMovement[]
  loyaltyRules       LoyaltyRuleBrand[]
  orderItems         OrderItem[]
  orders             Order[]

  @@map("brands")
}

model BankAccount {
  id               String            @id @default(uuid())
  name             String
  type             String
  holderName       String            @map("holder_name")
  bankName         String            @map("bank_name")
  accountNumber    String            @map("account_number")
  currentBalance   Decimal           @default(0) @map("current_balance") @db.Decimal(10, 2)
  isActive         Boolean           @default(true) @map("is_active")
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  version          Int               @default(1)
  financialRecords FinancialRecord[]
  orderReceipts    OrderReceipt[]
  orders           Order[]
  walletRecharges  WalletRecharge[]

  @@index([type])
  @@index([isActive])
  @@index([id, version])
  @@index([id, version], map: "idx_bank_accounts_version")
  @@map("bank_accounts")
}

model OrderReceipt {
  id                   String       @id @default(uuid())
  receiptNumber        String       @unique @map("receipt_number")
  clientId             String       @map("client_id")
  clientName           String       @map("client_name")
  salesChannel         String       @map("sales_channel")
  createdAt            DateTime     @default(now()) @map("created_at")
  transactionDate      DateTime     @map("transaction_date")
  paymentMethod        String       @map("payment_method")
  bankAccountId        String?      @map("bank_account_id")
  transactionReference String?      @map("transaction_reference")
  notes                String?
  createdByName        String?      @map("created_by_name")
  version              Int          @default(1)
  bankAccount          BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  client               Client       @relation(fields: [clientId], references: [id])
  orders               Order[]

  @@index([clientId])
  @@index([transactionDate])
  @@map("order_receipts")
}

model ReceptionBatch {
  id             String   @id @default(uuid())
  packingNumber  String   @unique @map("packing_number")
  packingTotal   Decimal  @map("packing_total") @db.Decimal(10, 2)
  receptionDate  DateTime @default(now()) @map("reception_date")
  receivedByName String   @map("received_by_name")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  orders         Order[]

  @@index([packingNumber])
  @@map("reception_batches")
}

model DeliveryBatch {
  id              String   @id @default(uuid())
  deliveryNumber  String   @unique @map("delivery_number")
  deliveryDate    DateTime @default(now()) @map("delivery_date")
  deliveredByName String   @map("delivered_by_name")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  orders          Order[]
  payments        OrderPayment[]
  financialRecords FinancialRecord[]

  @@index([deliveryNumber])
  @@map("delivery_batches")
}

model Order {
  id                   String              @id @default(uuid())
  receiptNumber        String              @map("receipt_number")
  salesChannel         String              @map("sales_channel")
  type                 String
  brandId              String              @map("brand_id")
  total                Decimal             @db.Decimal(10, 2)
  realInvoiceTotal     Decimal?            @map("real_invoice_total") @db.Decimal(10, 2)
  paymentMethod        String              @map("payment_method")
  bankAccountId        String?             @map("bank_account_id")
  transactionDate      DateTime            @map("transaction_date")
  possibleDeliveryDate DateTime            @map("possible_delivery_date")
  receptionDate        DateTime?           @map("reception_date")
  deliveryDate         DateTime?           @map("delivery_date")
  invoiceNumber        String?             @map("invoice_number")
  status               String              @default("POR_RECIBIR")
  clientId             String              @map("client_id")
  clientName           String              @map("client_name")
  notes                String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  version              Int                 @default(1)
  createdByName        String?             @map("created_by_name")
  deliveredByName      String?             @map("delivered_by_name")
  receivedByName       String?             @map("received_by_name")
  changeStatus         String?             @map("change_status")
  parentOrderId        String?             @map("parent_order_id")
  trackingGuide        String?             @map("tracking_guide")
  orderNumber          String?             @map("order_number")
  receiptId            String?             @map("receipt_id")
  documentType         String?             @default("FACTURA") @map("document_type")
  packingNumber        String?             @map("packing_number")
  packingTotal         Decimal?            @map("packing_total") @db.Decimal(10, 2)
  receptionBatchId     String?             @map("reception_batch_id")
  deliveryBatchId      String?             @map("delivery_batch_id")
  deliveryNumber       String?             @map("delivery_number")
  loyaltyRedemptionId  String?             @map("loyalty_redemption_id")
  exchangeItemId       String?             @unique @map("exchange_item_id")
  creditNoteNumber     String?             @map("credit_note_number")
  creditNoteTotal      Decimal?            @map("credit_note_total") @db.Decimal(10, 2)
  sourceOrderId        String?             @unique @map("source_order_id")
  sourceOrderNumber    String?             @map("source_order_number")
  sourceBrandName      String?             @map("source_brand_name")
  sourceQuantity       Int?                @map("source_quantity")
  sourceDescription    String?             @map("source_description")
  description          String?             @map("description")
  calls                Call[]
  catalogDelivery      CatalogDelivery?    @relation("CatalogOrder")
  exchangeBatchItems   ExchangeBatchItem[]
  financialRecords     FinancialRecord[]
  inventoryMovements   InventoryMovement[]
  exchangeItems        OrderExchangeItem[] @relation("OriginalOrderExchanges")
  items                OrderItem[]
  payments             OrderPayment[]
  bankAccount          BankAccount?        @relation(fields: [bankAccountId], references: [id])
  brand                Brand               @relation(fields: [brandId], references: [id])
  client               Client              @relation(fields: [clientId], references: [id])
  exchangeItem         OrderExchangeItem?  @relation("NewOrderExchange", fields: [exchangeItemId], references: [id])
  loyaltyRedemption    LoyaltyRedemption?  @relation(fields: [loyaltyRedemptionId], references: [id])
  parentOrder          Order?              @relation("OrderHeirs", fields: [parentOrderId], references: [id])
  childOrders          Order[]             @relation("OrderHeirs")
  receipt              OrderReceipt?       @relation(fields: [receiptId], references: [id])
  receptionBatch       ReceptionBatch?     @relation(fields: [receptionBatchId], references: [id])
  deliveryBatch        DeliveryBatch?      @relation(fields: [deliveryBatchId], references: [id])
  sourceOrder          Order?              @relation("ExchangeSource", fields: [sourceOrderId], references: [id])
  exchangesOriginated  Order[]             @relation("ExchangeSource")
  rewardApplications   RewardApplication?

  @@index([clientId])
  @@index([brandId])
  @@index([status])
  @@index([transactionDate])
  @@index([receiptNumber])
  @@index([receiptId])
  @@map("orders")
}

model OrderItem {
  id                   String    @id @default(uuid())
  orderId              String    @map("order_id")
  productName          String    @map("product_name")
  quantity             Int
  unitPrice            Decimal   @map("unit_price") @db.Decimal(10, 2)
  brandId              String    @map("brand_id")
  brandName            String    @map("brand_name")
  link                 String?
  possibleDeliveryDate DateTime? @map("possible_delivery_date")
  status               String?
  brand                Brand     @relation(fields: [brandId], references: [id])
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model OrderPayment {
  id                  String             @id @default(uuid())
  orderId             String             @map("order_id")
  amount              Decimal            @db.Decimal(10, 2)
  method              String
  reference           String?
  description         String?
  createdAt           DateTime           @default(now()) @map("created_at")
  receiptNumber       String?            @map("receipt_number")
  processingRequestId String?            @map("processing_request_id")
  financialRecords    FinancialRecord[]
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryBatchId     String?            @map("delivery_batch_id")
  deliveryBatch       DeliveryBatch?     @relation(fields: [deliveryBatchId], references: [id])
  processingRequest   ProcessingRequest? @relation(fields: [processingRequestId], references: [id])

  @@index([orderId])
  @@index([processingRequestId])
  @@map("order_payments")
}

model FinancialRecord {
  id                 String        @id @default(uuid())
  type               String
  referenceNumber    String        @unique @map("reference_number")
  amount             Decimal       @db.Decimal(10, 2)
  date               DateTime
  clientId           String        @map("client_id")
  clientName         String        @map("client_name")
  orderId            String?       @map("order_id")
  createdBy          String        @map("created_by")
  notes              String?
  bankAccountId      String        @map("bank_account_id")
  source             String
  paymentMethod      String?       @map("payment_method")
  movementType       String        @map("movement_type")
  createdAt          DateTime      @default(now()) @map("created_at")
  version            Int           @default(1)
  orderPaymentId     String?       @map("order_payment_id")
  userReference      String?       @map("user_reference")
  fromAccountType    String?       @map("from_account_type")
  toAccountType      String?       @map("to_account_type")
  transactionGroupId String?       @map("transaction_group_id")
  balanceBefore      Decimal?      @map("balance_before") @db.Decimal(10, 2)
  balanceAfter       Decimal?      @map("balance_after") @db.Decimal(10, 2)
  clientDocument     String?       @map("client_document")
  deliveryBatchId    String?       @map("delivery_batch_id")
  bankAccount        BankAccount   @relation(fields: [bankAccountId], references: [id])
  client             Client        @relation(fields: [clientId], references: [id])
  order              Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderPayment       OrderPayment? @relation(fields: [orderPaymentId], references: [id])
  deliveryBatch      DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id])

  @@index([clientId])
  @@index([orderId])
  @@index([orderPaymentId])
  @@index([bankAccountId])
  @@index([date])
  @@index([referenceNumber])
  @@index([date, movementType])
  @@index([createdAt, movementType])
  @@map("financial_records")
}

model ClientAccount {
  id                   String              @id @default(uuid())
  clientId             String              @unique @map("client_id")
  totalCreditAvailable Decimal             @default(0) @map("total_credit_available") @db.Decimal(10, 2)
  totalRewardPoints    Int                 @default(0) @map("total_reward_points")
  totalOrders          Int                 @default(0) @map("total_orders")
  totalSpent           Decimal             @default(0) @map("total_spent") @db.Decimal(10, 2)
  rewardLevel          String              @default("BRONCE") @map("reward_level")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  version              Int                 @default(1)
  client               Client              @relation(fields: [clientId], references: [id])
  credits              ClientCredit[]
  rewardApplications   RewardApplication[]

  @@index([id, version])
  @@index([id, version], map: "idx_client_accounts_version")
  @@map("client_accounts")
}

model ClientCredit {
  id                  String        @id @default(uuid())
  clientAccountId     String        @map("client_account_id")
  amount              Decimal       @db.Decimal(10, 2)
  remainingAmount     Decimal       @map("remaining_amount") @db.Decimal(10, 2)
  originTransactionId String        @unique @map("origin_transaction_id")
  originOrderId       String?       @map("origin_order_id")
  status              String        @default("AVAILABLE")
  createdAt           DateTime      @default(now()) @map("created_at")
  usedAt              DateTime?     @map("used_at")
  version             Int           @default(1)
  clientAccount       ClientAccount @relation(fields: [clientAccountId], references: [id])

  @@index([clientAccountId])
  @@index([status])
  @@index([clientAccountId, status])
  @@index([id, version])
  @@index([clientAccountId, status], map: "idx_client_credits_status")
  @@index([id, version], map: "idx_client_credits_version")
  @@map("client_credits")
}

model WalletRecharge {
  id              String       @id @default(uuid())
  clientId        String       @map("client_id")
  amount          Decimal      @db.Decimal(10, 2)
  paymentMethod   String       @map("payment_method")
  bankAccountId   String?      @map("bank_account_id")
  reference       String?    @unique
  controlValidation String?    @unique @map("control_validation")
  notes           String?
  status          String       @default("PENDIENTE_VALIDACION")
  createdByName   String?      @map("created_by_name")
  validatedByName String?      @map("validated_by_name")
  validatedAt     DateTime?    @map("validated_at")
  rejectionReason String?      @map("rejection_reason")
  isDismissed     Boolean      @default(false) @map("is_dismissed")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id])
  client          Client       @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([status])
  @@map("wallet_recharges")
}

model RewardApplication {
  id              String        @id @default(uuid())
  clientAccountId String        @map("client_account_id")
  orderId         String        @unique @map("order_id")
  pointsEarned    Int           @map("points_earned")
  appliedAt       DateTime      @default(now()) @map("applied_at")
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id])
  order           Order         @relation(fields: [orderId], references: [id])

  @@index([clientAccountId])
  @@map("reward_applications")
}

model InventoryMovement {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  clientId  String   @map("client_id")
  brandId   String   @map("brand_id")
  type      String
  createdBy String   @map("created_by")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  brand     Brand    @relation(fields: [brandId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([type])
  @@map("inventory_movements")
}

model CashClosure {
  id             String   @id @default(uuid())
  fromDate       DateTime @map("from_date")
  toDate         DateTime @map("to_date")
  notes          String?
  totalIncome    Decimal  @map("total_income") @db.Decimal(10, 2)
  totalExpense   Decimal  @map("total_expense") @db.Decimal(10, 2)
  expectedAmount Decimal  @map("expected_amount") @db.Decimal(10, 2)
  actualAmount   Decimal  @map("actual_amount") @db.Decimal(10, 2)
  difference     Decimal  @db.Decimal(10, 2)
  movementCount  Int      @map("movement_count")
  closedBy       String   @map("closed_by")
  closedAt       DateTime @default(now()) @map("closed_at")
  detailedReport Json?    @map("detailed_report")

  @@index([fromDate])
  @@index([toDate])
  @@index([closedAt])
  @@map("cash_closures")
}

model Call {
  id           String    @id @default(uuid())
  clientId     String    @map("client_id")
  orderId      String?   @map("order_id")
  reason       String
  result       String
  notes        String?
  followUpDate DateTime? @map("follow_up_date")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  client       Client    @relation(fields: [clientId], references: [id])
  order        Order?    @relation(fields: [orderId], references: [id])

  @@index([clientId])
  @@index([orderId])
  @@map("calls")
}

model User {
  id           String              @id @default(uuid())
  username     String              @unique
  password     String
  role         String              @default("USER")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  lastAccessAt DateTime?           @map("last_access_at")
  redemptions  LoyaltyRedemption[] @relation("RedemptionAuthor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model LoyaltyRule {
  id          String              @id @default(uuid())
  name        String
  type        String
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  description String?
  prizeId     String?             @map("prize_id")
  resetDays   Int?                @map("reset_days")
  targetValue Decimal             @map("target_value") @db.Decimal(10, 2)
  condition   String?
  pointsValue Int?                @map("points_value")
  redemptions LoyaltyRedemption[]
  brands      LoyaltyRuleBrand[]
  prize       LoyaltyPrize?       @relation(fields: [prizeId], references: [id])

  @@map("loyalty_rules")
}

model ProcessingRequest {
  id          String         @id @default(uuid())
  requestId   String         @unique @map("request_id")
  payload     Json
  result      Json?
  status      String
  error       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  completedAt DateTime?      @map("completed_at")
  payments    OrderPayment[]

  @@map("processing_requests")
}

model LoyaltyRuleBrand {
  ruleId  String      @map("rule_id")
  brandId String      @map("brand_id")
  brand   Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  rule    LoyaltyRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleId, brandId])
  @@map("loyalty_rule_brands")
}

model LoyaltyPrize {
  id             String              @id @default(uuid())
  name           String
  description    String?
  type           String
  pointsRequired Int?                @map("points_required")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  redemptions    LoyaltyRedemption[]
  rules          LoyaltyRule[]

  @@map("loyalty_prizes")
}

model LoyaltyRedemption {
  id             String       @id @default(uuid())
  clientId       String       @map("client_id")
  clientName     String       @map("client_name")
  prizeId        String       @map("prize_id")
  prizeName      String       @map("prize_name")
  status         String       @default("COMPLETADO")
  date           DateTime     @default(now()) @map("date")
  authorId       String?      @map("author_id")
  ruleId         String?      @map("rule_id")
  valueClaimed   Decimal?     @map("value_claimed") @db.Decimal(10, 2)
  author         User?        @relation("RedemptionAuthor", fields: [authorId], references: [id])
  client         Client       @relation(fields: [clientId], references: [id])
  prize          LoyaltyPrize @relation(fields: [prizeId], references: [id])
  rule           LoyaltyRule? @relation(fields: [ruleId], references: [id])
  consumedOrders Order[]

  @@map("loyalty_redemptions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  action    String
  module    String
  detail    String
  severity  String   @default("INFO")
  timestamp DateTime @default(now())
  success   Boolean  @default(true)

  @@index([userId])
  @@index([timestamp])
  @@index([module])
  @@map("audit_logs")
}

model CatalogInventory {
  id         String            @id @default(uuid())
  brandId    String            @map("brand_id")
  campaign   String
  quantity   Int
  createdBy  String            @map("created_by")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deliveries CatalogDelivery[]
  brand      Brand             @relation("BrandCatalogInventory", fields: [brandId], references: [id])

  @@unique([brandId, campaign])
  @@index([brandId])
  @@index([campaign])
  @@map("catalog_inventories")
}

model CatalogDelivery {
  id                 String           @id @default(uuid())
  clientId           String           @map("client_id")
  brandId            String           @map("brand_id")
  campaign           String
  quantity           Int              @default(1)
  type               String
  orderId            String?          @unique @map("order_id")
  catalogInventoryId String           @map("catalog_inventory_id")
  deliveredBy        String           @map("delivered_by")
  deliveredAt        DateTime         @default(now()) @map("delivered_at")
  notes              String?
  brand              Brand            @relation("BrandCatalogDelivery", fields: [brandId], references: [id])
  catalogInventory   CatalogInventory @relation(fields: [catalogInventoryId], references: [id])
  client             Client           @relation(fields: [clientId], references: [id])
  order              Order?           @relation("CatalogOrder", fields: [orderId], references: [id])

  @@index([clientId])
  @@index([brandId])
  @@index([campaign])
  @@index([deliveredAt])
  @@index([clientId, brandId])
  @@index([type])
  @@map("catalog_deliveries")
}

model ExchangeBatch {
  id            String              @id @default(uuid())
  batchNumber   String              @unique @map("batch_number")
  trackingGuide String?             @map("tracking_guide")
  status        String              @default("ENVIADO")
  notes         String?
  createdByName String?             @map("created_by_name")
  sentAt        DateTime?           @map("sent_at")
  receivedAt    DateTime?           @map("received_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deliveredAt   DateTime?           @map("delivered_at")
  items         ExchangeBatchItem[]

  @@index([status])
  @@map("exchange_batches")
}

model ExchangeBatchItem {
  id                 String        @id @default(uuid())
  batchId            String        @map("batch_id")
  orderId            String        @map("order_id")
  clientId           String        @map("client_id")
  clientName         String        @map("client_name")
  receiptNumber      String        @map("receipt_number")
  orderTotal         Decimal       @map("order_total") @db.Decimal(10, 2)
  invoiceTotal       Decimal?      @map("invoice_total") @db.Decimal(10, 2)
  paidAmount         Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  pendingAmount      Decimal       @default(0) @map("pending_amount") @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  financialProcessed Boolean       @default(false) @map("financial_processed")
  batch              ExchangeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order              Order         @relation(fields: [orderId], references: [id])

  @@index([batchId])
  @@index([orderId])
  @@map("exchange_batch_items")
}

model OrderExchange {
  id             String              @id @default(uuid())
  exchangeNumber String              @unique @map("exchange_number")
  clientId       String              @map("client_id")
  clientName     String              @map("client_name")
  status         String              @default("RECEIVED_FROM_CLIENT")
  notes          String?
  createdByName  String?             @map("created_by_name")
  sentAt         DateTime?           @map("sent_at")
  receivedAt     DateTime?           @map("received_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  items          OrderExchangeItem[]
  client         Client              @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([status])
  @@map("order_exchanges")
}

model OrderExchangeItem {
  id                 String        @id @default(uuid())
  exchangeId         String        @map("exchange_id")
  originalOrderId    String        @map("original_order_id")
  productName        String        @map("product_name")
  originalValue      Decimal       @map("original_value") @db.Decimal(10, 2)
  newValue           Decimal?      @map("new_value") @db.Decimal(10, 2)
  differenceValue    Decimal?      @map("difference_value") @db.Decimal(10, 2)
  status             String        @default("PENDING")
  financialProcessed Boolean       @default(false) @map("financial_processed")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  exchange           OrderExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  originalOrder      Order         @relation("OriginalOrderExchanges", fields: [originalOrderId], references: [id])
  newOrder           Order?        @relation("NewOrderExchange")

  @@index([exchangeId])
  @@index([originalOrderId])
  @@map("order_exchange_items")
}

model SystemSettings {
  id             String   @id @default(uuid())
  key            String   @unique
  value          String
  description    String?
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedByName  String?  @map("updated_by_name")

  @@map("system_settings")
}

model NoteTemplate {
  id             String   @id @default(uuid())
  title          String
  content        String
  type           String   // e.g., "NOTIMONCHITO"
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdByName  String?  @map("created_by_name")

  @@map("note_templates")
}

model OrderType {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("order_types")
}


model SalesChannel {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("sales_channels")
}

model SystemLock {
  id          String   @id @default(uuid())
  resourceId  String   @map("resource_id")
  resourceType String  @map("resource_type")
  userId      String   @map("user_id")
  userName    String   @map("user_name")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([resourceId, resourceType])
  @@index([resourceId, resourceType])
  @@index([expiresAt])
  @@map("system_locks")
}
