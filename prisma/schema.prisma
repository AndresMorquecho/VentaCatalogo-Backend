// Prisma Schema para VentasCatalogo
// Conectado a Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

model Client {
  id                   String   @id @default(uuid())
  identificationType   String   @map("identification_type")
  identificationNumber String   @unique @map("identification_number")
  firstName            String   @map("first_name")
  country              String
  province             String
  city                 String
  address              String
  neighborhood         String?
  sector               String?
  email                String
  phone1               String   @map("phone1")
  operator1            String   @map("operator1")
  phone2               String?  @map("phone2")
  operator2            String?  @map("operator2")
  reference            String?
  isActive             Boolean  @default(true) @map("is_active")
  
  // Nuevos campos FASE 1 & 2
  birthDate            DateTime? @map("birth_date")
  isWhatsApp           Boolean   @default(false) @map("is_whatsapp")
  referredById         String?   @map("referred_by_id")
  lastDataUpdate       DateTime  @default(now()) @map("last_data_update")
  lastOrderDate        DateTime? @map("last_order_date")
  lastBrandName        String?   @map("last_brand_name")
  isBlocked            Boolean   @default(false) @map("is_blocked")
  createdByName        String?   @map("created_by_name") // Usuario que registró a la empresaria

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  orders             Order[]
  orderReceipts      OrderReceipt[]
  clientAccount      ClientAccount?
  financialRecords   FinancialRecord[]
  calls              Call[]
  inventoryMovements InventoryMovement[]
  walletRecharges    WalletRecharge[]
  
  referredBy         Client?   @relation("ClientReferral", fields: [referredById], references: [id])
  referrals          Client[]  @relation("ClientReferral")

  @@index([firstName])
  @@index([email])
  @@index([identificationNumber])
  @@map("clients")
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  orders             Order[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  loyaltyRules       LoyaltyRule[]

  @@map("brands")
}

model BankAccount {
  id             String   @id @default(uuid())
  name           String
  type           String // BANK, CASH
  holderName     String   @map("holder_name")
  bankName       String   @map("bank_name")
  accountNumber  String   @map("account_number")
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  // Relations
  orders           Order[]
  orderReceipts    OrderReceipt[]
  financialRecords FinancialRecord[]
  walletRecharges  WalletRecharge[]

  @@index([type])
  @@index([isActive])
  @@index([id, version]) // Optimistic locking index
  @@map("bank_accounts")
}

// ============================================================================
// ORDERS AGGREGATE
// ============================================================================

model OrderReceipt {
  id                   String    @id @default(uuid())
  receiptNumber        String    @unique @map("receipt_number")
  clientId             String    @map("client_id")
  clientName           String    @map("client_name")
  salesChannel         String    @map("sales_channel")
  createdAt            DateTime  @default(now()) @map("created_at") // fecha de registro del recibo
  transactionDate      DateTime  @map("transaction_date")
  paymentMethod        String    @map("payment_method")
  bankAccountId        String?   @map("bank_account_id")
  transactionReference String?   @map("transaction_reference")
  notes                String?
  createdByName        String?   @map("created_by_name")
  version              Int       @default(1)

  // Relations
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  orders      Order[]

  @@index([clientId])
  @@index([transactionDate])
  @@map("order_receipts")
}

model ReceptionBatch {
  id              String   @id @default(uuid())
  packingNumber   String   @map("packing_number")
  packingTotal    Decimal  @db.Decimal(10, 2) @map("packing_total")
  receptionDate   DateTime @default(now()) @map("reception_date")
  receivedByName  String   @map("received_by_name")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  orders          Order[]

  @@index([packingNumber])
  @@map("reception_batches")
}

model Order {
  id                   String    @id @default(uuid())
  receiptNumber        String    @map("receipt_number") // denormalizado para consultas rápidas
  receiptId            String?   @map("receipt_id")
  salesChannel         String    @map("sales_channel") // OFICINA, WHATSAPP, DOMICILIO
  type                 String // NORMAL, PREVENTA, REPROGRAMACION
  brandId              String    @map("brand_id")
  total                Decimal   @db.Decimal(10, 2)
  realInvoiceTotal     Decimal?  @map("real_invoice_total") @db.Decimal(10, 2)
  paymentMethod        String    @map("payment_method") // EFECTIVO, TRANSFERENCIA, DEPOSITO, CHEQUE
  bankAccountId        String?   @map("bank_account_id")
  transactionDate      DateTime  @map("transaction_date")
  possibleDeliveryDate DateTime  @map("possible_delivery_date")
  receptionDate        DateTime? @map("reception_date")
  deliveryDate         DateTime? @map("delivery_date")
  invoiceNumber        String?   @map("invoice_number")
  documentType         String?   @map("document_type") @default("FACTURA")
  packingNumber        String?   @map("packing_number")
  packingTotal         Decimal?  @map("packing_total") @db.Decimal(10, 2)
  status               String    @default("POR_RECIBIR") // POR_RECIBIR, RECIBIDO_EN_BODEGA, ENTREGADO, CANCELADO
  clientId             String    @map("client_id")
  clientName           String    @map("client_name")
  notes                String?
  createdByName        String?   @map("created_by_name")   // Usuario que creó el pedido
  receivedByName       String?   @map("received_by_name")  // Usuario que recibió en bodega
  deliveredByName      String?   @map("delivered_by_name") // Usuario que procesó la entrega
  
  // Nuevos campos FASE 1 & 3 & 4
  receptionBatchId     String?   @map("reception_batch_id")
  parentOrderId        String?   @map("parent_order_id")
  orderNumber          String?   @map("order_number")
  trackingGuide        String?   @map("tracking_guide")
  changeStatus         String?   @map("change_status") // OFICINA, EMPRESA, RECIBIDO

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  version              Int       @default(1)

  // Relations
  client             Client              @relation(fields: [clientId], references: [id])
  brand              Brand               @relation(fields: [brandId], references: [id])
  bankAccount        BankAccount?        @relation(fields: [bankAccountId], references: [id])
  receipt            OrderReceipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           OrderPayment[]
  financialRecords   FinancialRecord[]
  inventoryMovements InventoryMovement[]
  calls              Call[]
  rewardApplications RewardApplication[]
  
  parentOrder        Order?              @relation("OrderHeirs", fields: [parentOrderId], references: [id])
  childOrders        Order[]             @relation("OrderHeirs")
  receptionBatch     ReceptionBatch?     @relation(fields: [receptionBatchId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([brandId])
  @@index([status])
  @@index([transactionDate])
  @@index([receiptNumber])
  @@index([receiptId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  productName String  @map("product_name")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  brandId     String  @map("brand_id")
  brandName   String  @map("brand_name")
  link        String?
  status      String? // NORMAL, REPROGRAMADO
  possibleDeliveryDate DateTime? @map("possible_delivery_date")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderPayment {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  amount      Decimal  @db.Decimal(10, 2)
  method      String // EFECTIVO, TRANSFERENCIA, DEPOSITO, CHEQUE, CREDITO_CLIENTE
  reference   String?
  receiptNumber String? @map("receipt_number") // Consecutivo propio del abono
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  financialRecords FinancialRecord[]

  @@index([orderId])
  @@map("order_payments")
}

// ============================================================================
// FINANCIAL RECORD AGGREGATE (UNIFICADO)
// ============================================================================

model FinancialRecord {
  id              String   @id @default(uuid())
  type            String // PAYMENT, ADJUSTMENT, EXPENSE
  referenceNumber String   @unique @map("reference_number")
  amount          Decimal  @db.Decimal(10, 2)
  date            DateTime

  // Audit Trail
  clientId   String  @map("client_id")
  clientName String  @map("client_name")
  orderId    String? @map("order_id")
  orderPaymentId String? @map("order_payment_id")
  createdBy  String  @map("created_by")
  notes      String?

  // Movement
  bankAccountId String  @map("bank_account_id")
  source        String // ORDER_PAYMENT, MANUAL, ADJUSTMENT
  paymentMethod String? @map("payment_method")
  movementType  String  @map("movement_type") // INCOME, EXPENSE

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  // Relations
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderPayment OrderPayment? @relation(fields: [orderPaymentId], references: [id], onDelete: SetNull)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([orderId])
  @@index([orderPaymentId])
  @@index([bankAccountId])
  @@index([date])
  @@index([referenceNumber])
  @@index([date, movementType])
  @@index([createdAt, movementType])
  @@map("financial_records")
}

// ============================================================================
// CLIENT ACCOUNT AGGREGATE
// ============================================================================

model ClientAccount {
  id                   String   @id @default(uuid())
  clientId             String   @unique @map("client_id")
  totalCreditAvailable Decimal  @default(0) @map("total_credit_available") @db.Decimal(10, 2)
  totalRewardPoints    Int      @default(0) @map("total_reward_points")
  totalOrders          Int      @default(0) @map("total_orders")
  totalSpent           Decimal  @default(0) @map("total_spent") @db.Decimal(10, 2)
  rewardLevel          String   @default("BRONCE") @map("reward_level") // BRONCE, PLATA, ORO, PLATINO
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  version              Int      @default(1)

  // Relations
  client             Client              @relation(fields: [clientId], references: [id])
  credits            ClientCredit[]
  rewardApplications RewardApplication[]

  @@index([id, version]) // Optimistic locking index
  @@map("client_accounts")
}

model ClientCredit {
  id                  String    @id @default(uuid())
  clientAccountId     String    @map("client_account_id")
  amount              Decimal   @db.Decimal(10, 2)
  remainingAmount     Decimal   @map("remaining_amount") @db.Decimal(10, 2)
  originTransactionId String    @unique @map("origin_transaction_id")
  originOrderId       String?   @map("origin_order_id")
  status              String    @default("AVAILABLE") // AVAILABLE, USED, EXPIRED
  createdAt           DateTime  @default(now()) @map("created_at")
  usedAt              DateTime? @map("used_at")
  version             Int       @default(1) // Optimistic locking

  // Relations
  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Restrict)

  @@index([clientAccountId])
  @@index([status])
  @@index([clientAccountId, status]) // TASK-5.3: Composite for AVAILABLE credit queries
  @@index([id, version]) // Optimistic locking index
  @@map("client_credits")
}

model WalletRecharge {
  id                  String   @id @default(uuid())
  clientId            String   @map("client_id")
  amount              Decimal  @db.Decimal(10, 2)
  paymentMethod       String   @map("payment_method") // EFECTIVO, TRANSFERENCIA, DEPOSITO
  bankAccountId       String?  @map("bank_account_id")
  reference           String?
  notes               String?
  status              String   @default("PENDIENTE_VALIDACION") // PENDIENTE_VALIDACION, VALIDADO, RECHAZADO
  createdByName       String?  @map("created_by_name")
  validatedByName     String?  @map("validated_by_name")
  validatedAt         DateTime? @map("validated_at")
  rejectionReason     String?  @map("rejection_reason")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  client      Client       @relation(fields: [clientId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([clientId])
  @@index([status])
  @@map("wallet_recharges")
}

model RewardApplication {
  id              String   @id @default(uuid())
  clientAccountId String   @map("client_account_id")
  orderId         String   @unique @map("order_id")
  pointsEarned    Int      @map("points_earned")
  appliedAt       DateTime @default(now()) @map("applied_at")

  // Relations
  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Restrict)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([clientAccountId])
  @@map("reward_applications")
}

// ============================================================================
// INVENTORY AGGREGATE
// ============================================================================

model InventoryMovement {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  clientId  String   @map("client_id")
  brandId   String   @map("brand_id")
  type      String // ENTRY, DELIVERED
  createdBy String   @map("created_by")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([type])
  @@map("inventory_movements")
}

// ============================================================================
// CASH CLOSURE AGGREGATE
// ============================================================================

model CashClosure {
  id             String   @id @default(uuid())
  fromDate       DateTime @map("from_date")
  toDate         DateTime @map("to_date")
  notes          String?
  totalIncome    Decimal  @map("total_income") @db.Decimal(10, 2)
  totalExpense   Decimal  @map("total_expense") @db.Decimal(10, 2)
  expectedAmount Decimal  @map("expected_amount") @db.Decimal(10, 2) // Current balance of cash account
  actualAmount   Decimal  @map("actual_amount") @db.Decimal(10, 2)   // Amount counted by user
  difference     Decimal  @db.Decimal(10, 2)                        // difference = actual - expected
  movementCount  Int      @map("movement_count")
  closedBy       String   @map("closed_by")
  closedAt       DateTime @default(now()) @map("closed_at")

  // Detailed report stored as JSON
  detailedReport Json? @map("detailed_report")

  @@index([fromDate])
  @@index([toDate])
  @@index([closedAt])
  @@map("cash_closures")
}

// ============================================================================
// CALLS & TRACKING
// ============================================================================

model Call {
  id           String    @id @default(uuid())
  clientId     String    @map("client_id")
  orderId      String?   @map("order_id")
  reason       String
  result       String
  notes        String?
  followUpDate DateTime? @map("follow_up_date")
  createdBy    String    @map("created_by")
  updatedBy    String?   @map("updated_by")  // Usuario que editó por última vez
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([clientId])
  @@index([orderId])
  @@map("calls")
}

// ============================================================================
// USERS & AUTH
// ============================================================================

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  password     String
  role         String    @default("USER") // ADMIN, USER, CAJERA, etc.
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastAccessAt DateTime? @map("last_access_at")

  redemptions LoyaltyRedemption[] @relation("RedemptionAuthor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] // Array of strings like "orders.view"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ============================================================================
// LOYALTY & REWARDS CONFIGURATION
// ============================================================================

model LoyaltyRule {
  id          String   @id @default(uuid())
  name        String
  type        String // POR_MONTO, POR_PEDIDO, OTRO
  pointsValue Int      @map("points_value")
  condition   String?
  brandId     String?  @map("brand_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  brand       Brand?   @relation(fields: [brandId], references: [id])

  @@map("loyalty_rules")
}

model LoyaltyPrize {
  id             String   @id @default(uuid())
  name           String
  description    String?
  type           String // DESCUENTO_PORCENTAJE, ENVIO_GRATIS, DESCUENTO_FIJO, PEDIDO_ESPECIAL
  pointsRequired Int      @map("points_required")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("loyalty_prizes")
}

model LoyaltyRedemption {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  clientName     String   @map("client_name")
  prizeId        String   @map("prize_id")
  prizeName      String   @map("prize_name")
  pointsUsed     Int      @map("points_used")
  status         String   @default("COMPLETADO") // PENDIENTE, COMPLETADO, CANCELADO
  date           DateTime @default(now()) @map("date")

  authorId       String?  @map("author_id")
  author         User?    @relation("RedemptionAuthor", fields: [authorId], references: [id])

  @@map("loyalty_redemptions")
}


// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  action    String
  module    String
  detail    String
  severity  String   @default("INFO")
  timestamp DateTime @default(now())
  success   Boolean  @default(true)

  @@index([userId])
  @@index([timestamp])
  @@index([module]) // TASK-5.2: Module filter is the most common query in the audit UI
  @@map("audit_logs")
}
