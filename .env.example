# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Genera una clave segura con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ CAMBIA ESTO EN PRODUCCIÓN
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-crypto-random
JWT_EXPIRES_IN=7d

